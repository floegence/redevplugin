{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "jsxImportSource": "@floegence/redevplugin-ui",
    "paths": {
      "@floegence/redevplugin-ui/jsx-runtime": ["./src/jsx-runtime.ts"],
      "@floegence/redevplugin-ui/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"]
    },
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
