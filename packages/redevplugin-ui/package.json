{
  "name": "@floegence/redevplugin-ui",
  "version": "3.3.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floegence/redevplugin.git",
    "directory": "packages/redevplugin-ui"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./trusted-parent": {
      "types": "./dist/trusted-parent.d.ts",
      "default": "./dist/trusted-parent.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./local-import": {
      "types": "./dist/local-import.d.ts",
      "default": "./dist/local-import.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@floegence/redevplugin-contracts": "3.3.0",
    "@noble/hashes": "2.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build_ui_package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/clean_typescript_test_output.mjs dist-test && npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.js"
  }
}
