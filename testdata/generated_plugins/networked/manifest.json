{
  "schema_version": "redevplugin.manifest.v9",
  "publisher": {
    "publisher_id": "example.generated",
    "display_name": "Example Generated"
  },
  "plugin": {
    "plugin_id": "com.example.generated.networked",
    "display_name": "Networked Generated Fixture",
    "version": "1.0.0"
  },
  "api": {
    "major": 1,
    "required_features": [
      "net.http.v1",
      "net.tcp.v1",
      "net.udp.v1",
      "net.websocket.v1"
    ],
    "optional_features": []
  },
  "permissions": [
    "network.client"
  ],
  "presentation": {
    "locales": {
      "default": "en-US"
    }
  },
  "surfaces": [
    {
      "surface_id": "networked.view",
      "kind": "view",
      "label": "Networked",
      "entry": "ui/index.html"
    }
  ],
  "workers": [],
  "methods": [],
  "network_access": {
    "connectors": [
      {
        "connector_id": "forecast_api",
        "transport": "http",
        "scope": "user",
        "destinations": [
          "https://api.example.com"
        ]
      },
      {
        "connector_id": "live_updates",
        "transport": "websocket",
        "scope": "user",
        "destinations": [
          "wss://stream.example.com"
        ]
      },
      {
        "connector_id": "database",
        "transport": "tcp",
        "scope": "environment",
        "destinations": [
          "db.example.com:5432"
        ]
      },
      {
        "connector_id": "metrics",
        "transport": "udp",
        "scope": "environment",
        "destinations": [
          "metrics.example.com:8125"
        ]
      }
    ]
  }
}
