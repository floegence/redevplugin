{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "WebWorker"
    ],
    "allowJs": true
  },
  "include": [
    "web-application/*.ts",
    "web-application/chunk.js"
  ]
}
