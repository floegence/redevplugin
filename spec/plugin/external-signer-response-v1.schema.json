{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.redevplugin.dev/plugin/external-signer-response-v1.schema.json",
  "title": "ReDevPlugin external signer response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "usage", "key_id", "signing_preimage_sha256", "algorithm", "signature"],
  "properties": {
    "schema_version": { "const": "redevplugin.external_signer_response.v1" },
    "request_id": { "$ref": "#/$defs/sha256" },
    "usage": { "$ref": "#/$defs/usage" },
    "key_id": { "$ref": "#/$defs/id" },
    "signing_preimage_sha256": { "$ref": "#/$defs/sha256" },
    "algorithm": { "const": "ed25519" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "usage": { "enum": [
      "redevplugin.release-signing.root-delegation.v1",
      "redevplugin.release-signing.package.v1",
      "redevplugin.release-signing.release-metadata.v1",
      "redevplugin.release-signing.source-policy-document.v1",
      "redevplugin.release-signing.source-policy-pointer.v1",
      "redevplugin.release-signing.revocation-document.v1",
      "redevplugin.release-signing.revocation-pointer.v1"
    ] }
  }
}
