{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "redevplugin.author-test.v1",
  "title": "Local author test result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "mode",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "const": "redevplugin.author-test.v1"
    },
    "ok": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "author-business-and-package",
        "real-runtime"
      ]
    },
    "commands": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "arguments",
          "output",
          "truncated",
          "duration_ms"
        ],
        "properties": {
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "package_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "runtime_result": {},
    "error": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "package_hash"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "else": {
        "required": [
          "error"
        ]
      }
    }
  ]
}
