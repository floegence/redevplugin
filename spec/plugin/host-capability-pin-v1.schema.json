{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.redevplugin.dev/plugin-api/1/host-capability-pin-v1.schema.json",
  "title": "ReDevPlugin known host capability contract identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["publisher_id", "contract_id", "contract_version", "artifact_sha256"],
  "properties": {
    "publisher_id": { "$ref": "#/$defs/id" },
    "contract_id": { "$ref": "#/$defs/id" },
    "contract_version": { "$ref": "#/$defs/semver" },
    "artifact_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
