{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.redevplugin.dev/plugin/bridge.schema.json",
  "title": "ReDevPlugin application bridge",
  "description": "Plugin-visible MessagePort contract. DOM, input, rendering and workers are application-owned. Host management credentials never enter the application.",
  "oneOf": [
    {
      "$ref": "#/$defs/call"
    },
    {
      "$ref": "#/$defs/execution_cancel"
    },
    {
      "$ref": "#/$defs/execution_query"
    },
    {
      "$ref": "#/$defs/execution_events"
    },
    {
      "$ref": "#/$defs/file_export"
    },
    {
      "$ref": "#/$defs/cancel"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/lifecycle"
    },
    {
      "$ref": "#/$defs/lifecycle_ack"
    },
    {
      "$ref": "#/$defs/context"
    },
    {
      "$ref": "#/$defs/client_ready"
    },
    {
      "$ref": "#/$defs/close_request"
    },
    {
      "$ref": "#/$defs/close_response"
    },
    {
      "$ref": "#/$defs/file_io"
    }
  ],
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "context"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.bridge.context"
        },
        "context": {
          "$ref": "https://schemas.redevplugin.dev/plugin/web-surface-transport.schema.json#/$defs/context_snapshot"
        }
      }
    },
    "opaque_handle": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{7,159}$"
    },
    "capability_business_error_details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "capability_version",
        "detail_schema_sha256",
        "business_error_code"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "capability_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "detail_schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "business_error_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "business_error_details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "worker_error_details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_error_code",
        "worker_error_message",
        "worker_error_origin"
      ],
      "properties": {
        "worker_error_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "worker_error_message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "worker_error_origin": {
          "enum": [
            "runtime",
            "hostcall",
            "plugin"
          ]
        }
      }
    },
    "request_id": {
      "type": "string",
      "pattern": "^(rpc|execution|file)_[1-9][0-9]{0,15}$"
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "request"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.bridge.call"
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "method"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/request_id"
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "params": {
              "type": "object",
              "description": "Optional JSON object. Arrays are rejected so worker calls match the Host RPC map contract."
            }
          }
        }
      }
    },
    "execution_events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "execution_id",
        "after_cursor"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.bridge.execution.events"
        },
        "id": {
          "$ref": "#/$defs/request_id"
        },
        "execution_id": {
          "$ref": "#/$defs/opaque_handle"
        },
        "after_cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "execution_cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "execution_id"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.bridge.execution.cancel"
        },
        "id": {
          "$ref": "#/$defs/request_id"
        },
        "execution_id": {
          "$ref": "#/$defs/opaque_handle"
        },
        "reason": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "execution_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "execution_id"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.bridge.execution.query"
        },
        "id": {
          "$ref": "#/$defs/request_id"
        },
        "execution_id": {
          "$ref": "#/$defs/opaque_handle"
        }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.bridge.cancel"
        },
        "id": {
          "$ref": "#/$defs/request_id"
        }
      }
    },
    "file_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "file_name",
        "media_type",
        "content"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.ui.file.export"
        },
        "id": {
          "$ref": "#/$defs/request_id"
        },
        "file_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "A leaf filename without path separators or control characters; UTF-8 encoding is limited to 255 bytes."
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/svg+xml",
            "text/plain"
          ]
        },
        "content": {
          "description": "One transferred ArrayBuffer containing 1-16777216 file bytes. The runtime validates the structured-clone object outside JSON Schema."
        }
      },
      "x-redevplugin-transfer": [
        "content"
      ],
      "x-redevplugin-host-authorization": "The host explicitly authorizes every export; interaction metadata grants no authority."
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "ok"
          ],
          "properties": {
            "type": {
              "const": "redevplugin.bridge.response"
            },
            "id": {
              "$ref": "#/$defs/request_id"
            },
            "ok": {
              "const": true
            },
            "data": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "ok",
            "error_code",
            "error"
          ],
          "properties": {
            "type": {
              "const": "redevplugin.bridge.response"
            },
            "id": {
              "$ref": "#/$defs/request_id"
            },
            "ok": {
              "const": false
            },
            "error_code": {
              "enum": [
                "PLUGIN_INVALID_REQUEST",
                "PLUGIN_MANIFEST_INVALID",
                "PLUGIN_PACKAGE_INVALID",
                "PLUGIN_PACKAGE_TOO_LARGE",
                "PLUGIN_PACKAGE_PATH_FORBIDDEN",
                "PLUGIN_SIGNATURE_INVALID",
                "PLUGIN_TRUST_STATE_DENIED",
                "PLUGIN_TRUST_VERIFICATION_REQUIRED",
                "PLUGIN_TRUST_VERIFICATION_INVALID",
                "PLUGIN_RELEASE_REF_VERIFICATION_FAILED",
                "PLUGIN_RELEASE_REF_POLICY_DENIED",
                "PLUGIN_RELEASE_NETWORK",
                "PLUGIN_RELEASE_TIMEOUT",
                "PLUGIN_RELEASE_ASSET_MISSING",
                "PLUGIN_RELEASE_ASSET_INTEGRITY",
                "PLUGIN_INSTALL_INTERRUPTED",
                "PLUGIN_INSTALL_STATE_CONFLICT",
                "PLUGIN_RETAINED_DATA_INCOMPATIBLE",
                "PLUGIN_INTERNAL_FAILURE",
                "PLUGIN_DISABLED",
                "PLUGIN_PERMISSION_DENIED",
                "PLUGIN_ORIGIN_DENIED",
                "PLUGIN_ACTION_DENIED",
                "PLUGIN_OWNER_SCOPE_MISMATCH",
                "PLUGIN_SECRET_SCOPE_MISMATCH",
                "PLUGIN_STORAGE_SCOPE_MISMATCH",
                "PLUGIN_ADAPTER_FAILURE",
                "PLUGIN_SESSION_REVOKED",
                "PLUGIN_SESSION_TEARDOWN_INCOMPLETE",
                "PLUGIN_SESSION_FENCE_CAPACITY",
                "PLUGIN_CONFIRMATION_REQUIRED",
                "PLUGIN_CONFIRMATION_INVALID",
                "PLUGIN_TOKEN_EXPIRED",
                "PLUGIN_TOKEN_REPLAY",
                "PLUGIN_GATEWAY_TOKEN_INVALID",
                "PLUGIN_GATEWAY_TOKEN_REPLAYED",
                "PLUGIN_GATEWAY_TOKEN_CHANNEL_MISMATCH",
                "PLUGIN_ASSET_TICKET_INVALID",
                "PLUGIN_ASSET_SESSION_INVALID",
                "PLUGIN_STREAM_TICKET_INVALID",
                "PLUGIN_STREAM_DELIVERY_INVALID",
                "PLUGIN_STREAM_CANCELLED",
                "PLUGIN_LEASE_INVALID",
                "PLUGIN_LEASE_REPLAYED",
                "PLUGIN_GRANT_INVALID",
                "PLUGIN_STORAGE_QUOTA_EXCEEDED",
                "PLUGIN_EXECUTION_BLOCKED",
                "PLUGIN_EXECUTION_NOT_FOUND",
                "PLUGIN_EXECUTION_NOT_CANCELABLE",
                "PLUGIN_CONNECTION_UNAVAILABLE",
                "PLUGIN_CONNECTION_CONFLICT",
                "PLUGIN_NETWORK_TARGET_DENIED",
                "PLUGIN_NETWORK_RATE_LIMITED",
                "PLUGIN_RUNTIME_UNAVAILABLE",
                "PLUGIN_RUNTIME_VERSION_MISMATCH",
                "PLUGIN_RUNTIME_CONTRACT_MISMATCH",
                "PLUGIN_UI_PROTOCOL_VIOLATION",
                "PLUGIN_SURFACE_QUIESCE_TIMEOUT",
                "PLUGIN_JSON_LIMIT_EXCEEDED",
                "PLUGIN_CAPABILITY_ERROR",
                "PLUGIN_WORKER_ERROR",
                "PLUGIN_FILE_OPERATION_FAILED",
                "PLUGIN_CONTRACT_MISMATCH",
                "PLUGIN_MANAGEMENT_REVISION_MISMATCH",
                "PLUGIN_AUTHORIZATION_REVISION_MISMATCH",
                "PLUGIN_BINDING_REVISION_MISMATCH",
                "PLUGIN_VALUES_REVISION_MISMATCH",
                "PLUGIN_CSRF_REQUIRED",
                "PLUGIN_CSRF_INVALID",
                "PLUGIN_FEATURE_NOT_CONFIGURED",
                "PLUGIN_CONFIRMATION_REJECTED",
                "PLUGIN_BRIDGE_CANCELLED",
                "PLUGIN_BRIDGE_TIMEOUT",
                "PLUGIN_BRIDGE_DISPOSED",
                "PLUGIN_BRIDGE_HANDSHAKE_FAILED",
                "PLUGIN_BRIDGE_HANDSHAKE_REQUIRED"
              ]
            },
            "error": {
              "type": "string",
              "maxLength": 4096
            },
            "error_details": {
              "type": "object",
              "maxProperties": 8,
              "additionalProperties": true
            },
            "mutation_outcome": {
              "type": "string",
              "enum": [
                "committed",
                "not_committed",
                "unknown"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "error_code": {
                    "const": "PLUGIN_CAPABILITY_ERROR"
                  }
                },
                "required": [
                  "error_code"
                ]
              },
              "then": {
                "required": [
                  "error_details"
                ],
                "properties": {
                  "error_details": {
                    "$ref": "#/$defs/capability_business_error_details"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "error_code": {
                    "const": "PLUGIN_WORKER_ERROR"
                  }
                },
                "required": [
                  "error_code"
                ]
              },
              "then": {
                "required": [
                  "error_details"
                ],
                "properties": {
                  "error_details": {
                    "$ref": "#/$defs/worker_error_details"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "error_code": {
                    "const": "PLUGIN_FILE_OPERATION_FAILED"
                  }
                },
                "required": [
                  "error_code"
                ]
              },
              "then": {
                "required": [
                  "error_details"
                ],
                "properties": {
                  "error_details": {
                    "$ref": "file-resources.schema.json#/$defs/error_details"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "event"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.bridge.lifecycle"
        },
        "quiesce_id": {
          "type": "string",
          "pattern": "^quiesce_[A-Za-z0-9_-]{8,151}$"
        },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "ready",
                "visible",
                "hidden",
                "dispose"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "quiesce_id"
            ]
          },
          "then": {
            "properties": {
              "event": {
                "properties": {
                  "type": {
                    "const": "dispose"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "lifecycle_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "quiesce_id"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.bridge.lifecycle_ack"
        },
        "quiesce_id": {
          "type": "string",
          "pattern": "^quiesce_[A-Za-z0-9_-]{8,151}$"
        }
      }
    },
    "client_ready": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.bridge.client_ready"
        }
      }
    },
    "close_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "close_id"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.bridge.close_request"
        },
        "close_id": {
          "type": "string",
          "pattern": "^close_[A-Za-z0-9_-]{8,153}$"
        }
      }
    },
    "close_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "close_id",
        "allow"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.bridge.close_response"
        },
        "close_id": {
          "type": "string",
          "pattern": "^close_[A-Za-z0-9_-]{8,153}$"
        },
        "allow": {
          "type": "boolean"
        }
      }
    },
    "file_io": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "request"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.bridge.file_io"
        },
        "id": {
          "type": "string",
          "pattern": "^file_[1-9][0-9]{0,15}$"
        },
        "request": {
          "$ref": "https://schemas.redevplugin.dev/plugin/file-resources.schema.json#/$defs/io_request"
        }
      }
    }
  }
}
