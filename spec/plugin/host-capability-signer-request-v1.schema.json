{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.redevplugin.dev/plugin/host-capability-signer-request-v1.schema.json",
  "title": "ReDevPlugin host capability signer request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "usage", "key_id", "publisher_id",
    "contract_id", "contract_version", "manifest_sha256",
    "signing_preimage_sha256", "signing_preimage"
  ],
  "properties": {
    "schema_version": { "const": "redevplugin.host_capability_signer_request.v1" },
    "request_id": { "$ref": "#/$defs/sha256" },
    "usage": { "const": "redevplugin.host-capability-signing.manifest.v1" },
    "key_id": { "$ref": "#/$defs/id" },
    "publisher_id": { "$ref": "#/$defs/id" },
    "contract_id": { "$ref": "#/$defs/id" },
    "contract_version": { "$ref": "#/$defs/semver" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "signing_preimage_sha256": { "$ref": "#/$defs/sha256" },
    "signing_preimage": { "type": "string", "minLength": 4, "maxLength": 1048576, "pattern": "^[A-Za-z0-9+/]*={0,2}$" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  }
}
