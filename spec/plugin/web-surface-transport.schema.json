{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.redevplugin.dev/plugin/web-surface-transport.schema.json",
  "title": "ReDevPlugin Web surface transport",
  "description": "Source, origin and port bound application bootstrap and lifecycle. The child is untrusted and no message grants host permissions.",
  "oneOf": [
    {
      "$ref": "#/$defs/port_envelope"
    },
    {
      "$ref": "#/$defs/port_ack"
    },
    {
      "$ref": "#/$defs/initialize"
    },
    {
      "$ref": "#/$defs/context"
    },
    {
      "$ref": "#/$defs/surface_error"
    },
    {
      "$ref": "#/$defs/interaction"
    },
    {
      "$ref": "#/$defs/entry_ready"
    },
    {
      "$ref": "#/$defs/entry_error"
    },
    {
      "$ref": "#/$defs/app_ready"
    },
    {
      "$ref": "#/$defs/navigation"
    },
    {
      "$ref": "#/$defs/quiesce_ack"
    },
    {
      "$ref": "#/$defs/file_export"
    },
    {
      "$ref": "#/$defs/close_request"
    },
    {
      "$ref": "#/$defs/close_response"
    }
  ],
  "$defs": {
    "opening_progress": {
      "description": "Host-local opening progress and timeout details. This is not a message and conveys no authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "elapsedMs",
        "stage",
        "stageElapsedMs",
        "pendingMilestones"
      ],
      "properties": {
        "phase": {
          "const": "opening"
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0
        },
        "stage": {
          "enum": [
            "preparing",
            "connecting",
            "authorizing",
            "initializing"
          ]
        },
        "stageElapsedMs": {
          "type": "integer",
          "minimum": 0
        },
        "pendingMilestones": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "prepare",
              "origin",
              "entry_ready",
              "port_ack",
              "token",
              "app_ready"
            ]
          }
        }
      }
    },
    "opaque_handle": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{7,159}$"
    },
    "port_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "frame_generation_id",
        "document_id"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.surface.port"
        },
        "frame_generation_id": {
          "$ref": "#/$defs/opaque_handle"
        },
        "document_id": {
          "type": "string",
          "pattern": "^document_[A-Za-z0-9_-]{8,151}$"
        }
      }
    },
    "port_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "frame_generation_id"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.surface.port_ack"
        },
        "frame_generation_id": {
          "$ref": "#/$defs/opaque_handle"
        }
      }
    },
    "initialize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "frame_generation_id",
        "surface_handle",
        "entry_path"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.surface.initialize"
        },
        "frame_generation_id": {
          "$ref": "#/$defs/opaque_handle"
        },
        "surface_handle": {
          "$ref": "#/$defs/opaque_handle"
        },
        "context": {
          "$ref": "#/$defs/context_snapshot"
        },
        "entry_path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 2048
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "frame_generation_id",
        "surface_handle",
        "context"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.surface.context"
        },
        "frame_generation_id": {
          "$ref": "#/$defs/opaque_handle"
        },
        "surface_handle": {
          "$ref": "#/$defs/opaque_handle"
        },
        "context": {
          "$ref": "#/$defs/context_snapshot"
        }
      }
    },
    "context_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "revision",
        "appearance",
        "locale"
      ],
      "properties": {
        "schema_version": {
          "const": "redevplugin.surface_context.v1"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "appearance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color_scheme",
            "colors"
          ],
          "properties": {
            "color_scheme": {
              "enum": [
                "light",
                "dark"
              ]
            },
            "colors": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "canvas",
                "surface",
                "surface_elevated",
                "text",
                "text_muted",
                "border",
                "accent",
                "accent_text",
                "success",
                "warning",
                "danger",
                "focus"
              ],
              "properties": {
                "canvas": {
                  "$ref": "#/$defs/color"
                },
                "surface": {
                  "$ref": "#/$defs/color"
                },
                "surface_elevated": {
                  "$ref": "#/$defs/color"
                },
                "text": {
                  "$ref": "#/$defs/color"
                },
                "text_muted": {
                  "$ref": "#/$defs/color"
                },
                "border": {
                  "$ref": "#/$defs/color"
                },
                "accent": {
                  "$ref": "#/$defs/color"
                },
                "accent_text": {
                  "$ref": "#/$defs/color"
                },
                "success": {
                  "$ref": "#/$defs/color"
                },
                "warning": {
                  "$ref": "#/$defs/color"
                },
                "danger": {
                  "$ref": "#/$defs/color"
                },
                "focus": {
                  "$ref": "#/$defs/color"
                }
              }
            }
          }
        },
        "locale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "language_tag",
            "direction"
          ],
          "properties": {
            "language_tag": {
              "type": "string",
              "minLength": 2,
              "maxLength": 64
            },
            "direction": {
              "enum": [
                "ltr",
                "rtl"
              ]
            }
          }
        }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$"
    },
    "surface_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "error"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.surface.error"
        },
        "error": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "interaction": {
      "description": "Port-bound host UI ownership observation. action and target_key are plugin-controlled semantic metadata and MUST NOT be used for permission, route authorization, or privilege decisions.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "frame_generation_id",
        "surface_handle",
        "sequence",
        "kind",
        "target_key",
        "action",
        "local_scroll",
        "selection_active"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.surface.interaction"
        },
        "frame_generation_id": {
          "$ref": "#/$defs/opaque_handle"
        },
        "surface_handle": {
          "$ref": "#/$defs/opaque_handle"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string",
          "enum": [
            "activation",
            "focus",
            "wheel",
            "text-selection",
            "action"
          ]
        },
        "target_key": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "action": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[-A-Za-z0-9._:]{1,128}$"
        },
        "local_scroll": {
          "type": "boolean"
        },
        "selection_active": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "action"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "action": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "wheel"
              }
            },
            "required": [
              "kind"
            ]
          },
          "else": {
            "properties": {
              "local_scroll": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text-selection"
              }
            },
            "required": [
              "kind"
            ]
          },
          "else": {
            "properties": {
              "selection_active": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "entry_ready": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "entry_path",
        "document_id"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.surface.entry_ready"
        },
        "entry_path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 2048
        },
        "document_id": {
          "type": "string",
          "pattern": "^document_[A-Za-z0-9_-]{8,151}$"
        }
      }
    },
    "entry_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "error"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.surface.entry_error"
        },
        "error": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "app_ready": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "frame_generation_id"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.surface.app_ready"
        },
        "frame_generation_id": {
          "$ref": "#/$defs/opaque_handle"
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "frame_generation_id"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.surface.navigation"
        },
        "frame_generation_id": {
          "$ref": "#/$defs/opaque_handle"
        }
      }
    },
    "quiesce_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "quiesce_id"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.surface.quiesce_ack"
        },
        "quiesce_id": {
          "$ref": "#/$defs/opaque_handle"
        }
      }
    },
    "file_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "file_name",
        "media_type",
        "content",
        "frame_generation_id",
        "surface_handle"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.surface.file.export"
        },
        "id": {
          "type": "string",
          "pattern": "^file_[1-9][0-9]{0,15}$"
        },
        "file_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "A leaf filename without path separators or control characters; UTF-8 encoding is limited to 255 bytes."
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/svg+xml",
            "text/plain"
          ]
        },
        "content": {
          "description": "One transferred ArrayBuffer containing 1-16777216 file bytes. The runtime validates the structured-clone object outside JSON Schema."
        },
        "frame_generation_id": {
          "$ref": "#/$defs/opaque_handle"
        },
        "surface_handle": {
          "$ref": "#/$defs/opaque_handle"
        }
      },
      "x-redevplugin-transfer": [
        "content"
      ],
      "x-redevplugin-host-authorization": "The host explicitly authorizes every export; interaction metadata grants no authority."
    },
    "close_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "close_id"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.bridge.close_request"
        },
        "close_id": {
          "type": "string",
          "pattern": "^close_[A-Za-z0-9_-]{8,153}$"
        }
      }
    },
    "close_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "close_id",
        "allow"
      ],
      "properties": {
        "type": {
          "const": "redevplugin.bridge.close_response"
        },
        "close_id": {
          "type": "string",
          "pattern": "^close_[A-Za-z0-9_-]{8,153}$"
        },
        "allow": {
          "type": "boolean"
        }
      }
    },
    "origin_preparation": {
      "description": "Trusted-parent routing adapter request. No token or bootstrap URL is exposed. Completion permits only the platform-owned navigation; return values cannot replace it. signal is a surface-lifetime AbortSignal, not a JSON value. Abort or opening deadline prevents navigation; the host expires or releases product routing independently of platform revocation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "parentOrigin",
        "pluginInstanceId",
        "surfaceInstanceId",
        "signal"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "parentOrigin": {
          "type": "string",
          "format": "uri"
        },
        "pluginInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "surfaceInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "signal": {
          "description": "A native AbortSignal. It is aborted on close, invalidation, failure, and opening timeout; the request is never serialized to the plugin."
        }
      }
    }
  }
}
