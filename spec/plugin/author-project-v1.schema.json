{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "redevplugin.author-project.v1",
  "title": "Explicit local author project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "output",
    "build",
    "test",
    "watch"
  ],
  "properties": {
    "schema_version": {
      "const": "redevplugin.project.v1"
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical project-relative directory, separate from watch inputs; symlinks are rejected.",
      "pattern": "^[^/\\\\\u0000]+(/[^/\\\\\u0000]+)*$",
      "not": {
        "pattern": "(^|/)\\.{1,2}(/|$)"
      }
    },
    "build": {
      "$ref": "#/$defs/argv"
    },
    "test": {
      "$ref": "#/$defs/argv"
    },
    "watch": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/\\\\\u0000]+(/[^/\\\\\u0000]+)*$",
        "not": {
          "pattern": "(^|/)\\.{1,2}(/|$)"
        }
      }
    }
  },
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 8192,
        "pattern": "^[^\u0000]*$"
      },
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S",
          "allOf": [
            {
              "pattern": "^[^\u0000]*$"
            }
          ]
        }
      ]
    }
  }
}
