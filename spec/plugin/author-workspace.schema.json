{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "redevplugin.author-workspace.v1",
  "title": "Managed author workspace and immutable artifact",
  "description": "Host-neutral author metadata. Ownership is derived from authenticated context and is never a wire input.",
  "oneOf": [
    {
      "$ref": "#/$defs/workspace"
    },
    {
      "$ref": "#/$defs/artifact"
    }
  ],
  "$defs": {
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "source_directory",
        "development_directory",
        "created_at"
      ],
      "properties": {
        "workspace_id": {
          "type": "string",
          "pattern": "^author_[A-Z2-7]{26}$"
        },
        "source_directory": {
          "type": "string",
          "minLength": 1
        },
        "development_directory": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "workspace_id",
        "source_sha256",
        "package_sha256",
        "plugin_id",
        "version",
        "created_at",
        "stages"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^artifact_[A-Z2-7]{26}$"
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^author_[A-Z2-7]{26}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "package_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "plugin_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status",
              "duration_ms"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "not_run"
                ]
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
