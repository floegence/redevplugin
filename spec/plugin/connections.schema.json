{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.redevplugin.dev/plugin/connections.schema.json",
  "title": "Controlled network connections",
  "oneOf": [
    {
      "$ref": "#/$defs/review_request"
    },
    {
      "$ref": "#/$defs/review_reference"
    },
    {
      "$ref": "#/$defs/list_request"
    },
    {
      "$ref": "#/$defs/revoke_request"
    },
    {
      "$ref": "#/$defs/review"
    },
    {
      "$ref": "#/$defs/connection"
    },
    {
      "$ref": "#/$defs/web_connection"
    },
    {
      "$ref": "#/$defs/review_result"
    },
    {
      "$ref": "#/$defs/connection_list"
    }
  ],
  "$defs": {
    "review_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_instance_id",
        "connector_id",
        "destination",
        "expected_revision"
      ],
      "properties": {
        "plugin_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "connector_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "http_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "GET",
              "HEAD",
              "OPTIONS",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          }
        },
        "secret_ref": {
          "type": "string",
          "minLength": 1
        },
        "private_prefixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_instance_id",
        "review_id"
      ],
      "properties": {
        "plugin_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "review_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "list_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_instance_id"
      ],
      "properties": {
        "plugin_instance_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "revoke_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_instance_id",
        "connector_id",
        "expected_revision"
      ],
      "properties": {
        "plugin_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "connector_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_instance_id",
        "connector_id",
        "destination",
        "expected_revision",
        "review_id",
        "scope",
        "review_expires_at",
        "expires_at"
      ],
      "properties": {
        "plugin_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "connector_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "http_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "GET",
              "HEAD",
              "OPTIONS",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          }
        },
        "secret_ref": {
          "type": "string",
          "minLength": 1
        },
        "private_prefixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "user",
            "environment"
          ]
        },
        "review_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector_id",
        "scope",
        "revision",
        "status"
      ],
      "properties": {
        "connector_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
        },
        "connection_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "user",
            "environment"
          ]
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "http_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "GET",
              "HEAD",
              "OPTIONS",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          }
        },
        "secret_ref": {
          "type": "string",
          "minLength": 1
        },
        "private_prefixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "fixed",
            "unconfigured",
            "active",
            "expired",
            "revoked",
            "stale"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "web_connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector_id",
        "connection_id",
        "base_path",
        "http_methods"
      ],
      "properties": {
        "connector_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
        },
        "connection_id": {
          "type": "string",
          "minLength": 1
        },
        "base_path": {
          "type": "string",
          "minLength": 1
        },
        "http_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "GET",
              "HEAD",
              "OPTIONS",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          }
        }
      }
    },
    "review_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review"
      ],
      "properties": {
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "connection_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connections"
      ],
      "properties": {
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connection"
          }
        }
      }
    }
  }
}
