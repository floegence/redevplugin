{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.redevplugin.dev/plugin-api/1/repository-index-v1.schema.json",
  "title": "ReDevPlugin repository index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "targets"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schema_version": {
      "const": "redevplugin.repository-index.v1"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/target"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:\\.|[A-Za-z0-9_][A-Za-z0-9._-]*(?:/[A-Za-z0-9_][A-Za-z0-9._-]*)*)$"
    },
    "template": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9._+@-]*\\{version\\}[A-Za-z0-9._+@-]*$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag_template",
        "package_asset_template"
      ],
      "properties": {
        "tag_template": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v\\{version\\}$"
        },
        "package_asset_template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9._+@-]+(?:\\{version\\}[A-Za-z0-9._+@-]*)?\\.redevplugin$"
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_id",
        "path",
        "manifest",
        "release"
      ],
      "properties": {
        "plugin_id": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "manifest": {
          "allOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "not": {
                "const": "."
              }
            }
          ]
        },
        "release": {
          "$ref": "#/$defs/release"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ecosystem",
        "host",
        "plugins"
      ],
      "properties": {
        "ecosystem": {
          "const": "redevplugin"
        },
        "host": {
          "$ref": "#/$defs/identifier"
        },
        "plugins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/plugin"
          }
        }
      }
    }
  }
}
