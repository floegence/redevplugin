{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.redevplugin.dev/plugin/owner-scope-root-recovery-v1.schema.json",
  "title": "ReDevPlugin explicit owner scope root recovery journal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recovery_id",
    "plan_sha256",
    "root_identity_sha256",
    "source_journal_sha256",
    "source_snapshot_sha256",
    "source_entry_count",
    "source_bytes",
    "has_retained_quarantine",
    "top_level_entries",
    "state",
    "quarantine_id",
    "quarantine_sha256",
    "fresh_migration_id",
    "fresh_generation_id",
    "fresh_generation_sha256"
  ],
  "properties": {
    "schema_version": { "const": "owner-scope-root-recovery-v1" },
    "recovery_id": { "type": "string", "pattern": "^recovery_[0-9a-f]{32}$" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "root_identity_sha256": { "$ref": "#/$defs/sha256" },
    "source_journal_sha256": { "$ref": "#/$defs/sha256" },
    "source_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "source_entry_count": { "type": "integer", "minimum": 1, "maximum": 200000 },
    "source_bytes": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
    "has_retained_quarantine": { "type": "boolean" },
    "top_level_entries": {
      "oneOf": [
        { "const": [".redevplugin-current-generation", ".redevplugin-generations", ".redevplugin-owner-scope-migration-v1.json"] },
        { "const": [".redevplugin-current-generation", ".redevplugin-generations", ".redevplugin-owner-scope-migration-v1.json", ".redevplugin-quarantine"] }
      ]
    },
    "state": {
      "enum": [
        "prepared",
        "archive_writing",
        "archive_committed",
        "fresh_prepared",
        "fresh_committed",
        "reconcile_required",
        "failed"
      ]
    },
    "quarantine_id": { "type": "string", "pattern": "^quarantine_[0-9a-f]{32}$" },
    "quarantine_sha256": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" },
    "fresh_migration_id": { "type": "string", "pattern": "^migration_[0-9a-f]{32}$" },
    "fresh_generation_id": { "type": "string", "pattern": "^generation_[0-9a-f]{32}$" },
    "fresh_generation_sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "has_retained_quarantine": { "const": true } }, "required": ["has_retained_quarantine"] },
      "then": { "properties": { "top_level_entries": { "const": [".redevplugin-current-generation", ".redevplugin-generations", ".redevplugin-owner-scope-migration-v1.json", ".redevplugin-quarantine"] } } },
      "else": { "properties": { "top_level_entries": { "const": [".redevplugin-current-generation", ".redevplugin-generations", ".redevplugin-owner-scope-migration-v1.json"] } } }
    },
    {
      "if": { "properties": { "state": { "enum": ["prepared", "archive_writing"] } }, "required": ["state"] },
      "then": { "properties": { "quarantine_sha256": { "const": "" } } }
    },
    {
      "if": { "properties": { "state": { "enum": ["archive_committed", "fresh_prepared", "fresh_committed"] } }, "required": ["state"] },
      "then": { "properties": { "quarantine_sha256": { "$ref": "#/$defs/sha256" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
