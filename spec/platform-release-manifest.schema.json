{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.redevplugin.dev/platform-release-manifest.schema.json",
  "title": "ReDevPlugin Platform Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform_version", "plugin_api", "internal_wire", "artifacts"],
  "properties": {
    "platform_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "plugin_api": {"const": 1},
    "internal_wire": {"const": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(go|npm|crate|contract):[^\\s=]+$",
          "not": {"const": "contract:platform-release-manifest"}
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
