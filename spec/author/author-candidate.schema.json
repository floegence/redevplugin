{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redevplugin.dev/spec/author/author-candidate.schema.json",
  "title": "ReDevPlugin author candidate",
  "type": "object",
  "required": ["author_project_id", "owner_scope", "source_sha256", "package_sha256", "generation", "issued_at", "expires_at"],
  "additionalProperties": false,
  "properties": {
    "author_project_id": { "type": "string", "minLength": 1 },
    "owner_scope": { "type": "string", "minLength": 1 },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "package_sha256": { "$ref": "#/$defs/sha256" },
    "generation": { "type": "integer", "minimum": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" } }
}
