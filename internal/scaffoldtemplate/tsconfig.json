{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@floegence/redevplugin-ui",
    "baseUrl": "../..",
    "paths": {
      "@floegence/redevplugin-ui/plugin": ["packages/redevplugin-ui/src/plugin.ts"],
      "@floegence/redevplugin-ui/jsx-runtime": ["packages/redevplugin-ui/src/jsx-runtime.ts"]
    },
    "lib": ["ES2022", "DOM", "WebWorker"]
  },
  "include": ["plugin-worker.tsx"]
}
