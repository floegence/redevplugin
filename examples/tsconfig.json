{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "include": [
    "plugin-ui/**/*.ts",
    "showcase/**/*.ts",
    "plugin-ui/**/*.tsx"
  ]
}
